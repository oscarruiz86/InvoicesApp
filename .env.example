FRONTEND_PORT=
BACKEND_PORT=
MONGO_PORT=
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
INVOICES_WEB_ORIGIN=http://localhost:5173
# Solo rutas/identificadores; guardar los secretos en archivos ignorados bajo secrets/.
KC_BOOTSTRAP_ADMIN_USERNAME=
KEYCLOAK_SECRET_DIR=./secrets
OFFLINE_CREDENTIAL_SIGNING_KEY_FILE=/run/secrets/offline-credential-signing-key
OFFLINE_CREDENTIAL_KEY_ID=offline-v1
OFFLINE_CREDENTIAL_TTL_HOURS=72
# Host path to the PKCS#8 private key used by production Compose; keep this file out of Git.
OFFLINE_CREDENTIAL_SECRET_FILE=/mnt/pool_main/docker/invoice/secrets/offline-credential-signing-key
# Clave pública ES256 incluida en el bundle web; es JWK público con campo kid, nunca incluir d.
VITE_OFFLINE_CREDENTIAL_PUBLIC_JWKS=

# SMTP opcional. Los valores secretos se montan como archivos; no se guardan aquí.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD_FILE=/run/secrets/smtp-password
SMTP_TLS_MODE=plain
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Invoices App
SMTP_TIMEOUT_MS=10000
INVITATION_PUBLIC_ORIGIN=http://localhost:5173
NOTIFICATION_PAYLOAD_KEY_FILE=/run/secrets/notification-payload-key
SMTP_SECRET_DIR=./secrets
# Para rotación: lista version=ruta separada por punto y coma. Mantén la clave anterior mientras haya trabajos pendientes cifrados.
NOTIFICATION_PAYLOAD_KEY_FILES=
NOTIFICATION_PAYLOAD_ACTIVE_KEY_VERSION=1
