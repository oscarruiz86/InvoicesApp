FRONTEND_PORT=
BACKEND_PORT=
MONGO_PORT=
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
INVOICES_WEB_ORIGIN=http://localhost:5173
# Suministrar valores propios en .env, nunca en el repositorio.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# SMTP opcional. Los valores secretos se montan como archivos; no se guardan aquí.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD_FILE=/run/secrets/smtp-password
SMTP_TLS_MODE=plain
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Invoices App
SMTP_TIMEOUT_MS=10000
INVITATION_PUBLIC_ORIGIN=http://localhost:5173
NOTIFICATION_PAYLOAD_KEY_FILE=/run/secrets/notification-payload-key
SMTP_SECRET_DIR=./secrets
# Para rotación: lista version=ruta separada por punto y coma. Mantén la clave anterior mientras haya trabajos pendientes cifrados.
NOTIFICATION_PAYLOAD_KEY_FILES=
NOTIFICATION_PAYLOAD_ACTIVE_KEY_VERSION=1
