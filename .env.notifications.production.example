# Variables de Compose para Notifications en producción. Copiar a .env.notifications.production.
# Este archivo solo contiene configuración y rutas; nunca pegar aquí los contenidos de secretos.
INVITATION_PUBLIC_ORIGIN=https://app.example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_TLS_MODE=starttls
SMTP_FROM_ADDRESS=notifications@example.com
SMTP_FROM_NAME=Invoices
SMTP_TIMEOUT_MS=10000
MONGODB_URI_SECRET_FILE=/srv/invoices/secrets/mongodb-uri
SMTP_PASSWORD_SECRET_FILE=/srv/invoices/secrets/smtp-password
NOTIFICATION_PAYLOAD_KEYS_DIR=/srv/invoices/secrets/notification-payload-keys
NOTIFICATION_PAYLOAD_KEY_FILES=1=/run/secrets/notification-payload-keys/v1
NOTIFICATION_PAYLOAD_ACTIVE_KEY_VERSION=1
