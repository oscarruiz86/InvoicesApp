NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/invoices_app?replicaSet=invoices-rs&directConnection=true
INVOICE_IMAGE_STORAGE_PROVIDER=local
INVOICE_IMAGE_STORAGE_LOCAL_ROOT=C:/invoice-app/invoice-images
INVOICE_IMAGE_STORAGE_COMPANY_ID=000000000000000000000000
# Opcionales juntas para rutas públicas; obligatorias para /api/auth/me.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/invoices
KEYCLOAK_AUDIENCE=invoices-api
# Host: se deriva del issuer. Compose lo sustituye por el destino interno.
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/invoices/protocol/openid-connect/certs
# Host: usa el issuer público. Compose lo sustituye por el nombre de servicio interno.
KEYCLOAK_DIRECTORY_ISSUER_URL=http://localhost:8080/realms/invoices
# Cliente confidencial de solo lectura; completar únicamente en el entorno privado del backend.
KEYCLOAK_DIRECTORY_CLIENT_ID=
KEYCLOAK_DIRECTORY_CLIENT_SECRET_FILE=/run/secrets/keycloak-directory-client-secret
# Habilitar únicamente para desarrollo/pruebas con destino público conocido.
# INVITATION_DELIVERY_MODE=log
# INVITATION_PUBLIC_ORIGIN=http://localhost:5173
INVITATION_TTL_HOURS=72
